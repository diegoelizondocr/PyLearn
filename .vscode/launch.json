{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI (local)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8001"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}